{
  "name": "unit01-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "version": "1.0.0",
  "description": "Directive AI Indexer & Sandbox - Unit 01",
  "type": "module",
  "main": "dist/packages/cli/src/index.js",
  "bin": {
    "u01": "./dist/packages/cli/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "rm -rf packages/core/dist packages/pro/dist packages/cli/dist && cp -r dist/core/src packages/core/dist && (cp -r dist/pro/src packages/pro/dist 2>/dev/null || true) && cp -r dist/cli/src packages/cli/dist && ln -sf cli/src/index.js dist/index.js",
    "start": "npm run build && node --no-warnings dist/index.js",
    "dev": "node --no-warnings --import tsx packages/cli/src/index.tsx"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "ignore": "^7.0.5",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^12.0.1",
    "marked-terminal": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-typescript": "^0.21.1"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.31",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
